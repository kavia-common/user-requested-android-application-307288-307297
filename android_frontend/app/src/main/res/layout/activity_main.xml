<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Main content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ocean_background"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Ocean.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
            app:title="@string/title_tic_tac_toe" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Turn indicator -->
                <TextView
                    android:id="@+id/statusText"
                    style="@style/TextAppearance.Ocean.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    tools:text="Turn: X"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Score row -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scoreCard"
                    style="@style/Widget.Ocean.ScoreCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/statusText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/scoreX"
                            style="@style/TextAppearance.Ocean.Score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/score_x_default" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:alpha="0.35"
                            android:background="@color/ocean_outline" />

                        <TextView
                            android:id="@+id/scoreDraws"
                            style="@style/TextAppearance.Ocean.Score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/score_draw_default" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:alpha="0.35"
                            android:background="@color/ocean_outline" />

                        <TextView
                            android:id="@+id/scoreO"
                            style="@style/TextAppearance.Ocean.Score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/score_o_default" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Board container gives subtle elevation + consistent spacing -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/boardCard"
                    style="@style/Widget.Ocean.BoardCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/scoreCard"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="1:1">

                    <androidx.gridlayout.widget.GridLayout
                        android:id="@+id/board"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        app:alignmentMode="alignMargins"
                        app:columnCount="3"
                        app:rowCount="3"
                        app:useDefaultMargins="true">

                        <!-- Row 0 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell0"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="0"
                            app:layout_column="0" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell1"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="0"
                            app:layout_column="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell2"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="0"
                            app:layout_column="2" />

                        <!-- Row 1 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell3"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="1"
                            app:layout_column="0" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell4"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="1"
                            app:layout_column="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell5"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="1"
                            app:layout_column="2" />

                        <!-- Row 2 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell6"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="2"
                            app:layout_column="0" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell7"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="2"
                            app:layout_column="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cell8"
                            style="@style/Widget.Ocean.CellButton"
                            app:layout_row="2"
                            app:layout_column="2" />
                    </androidx.gridlayout.widget.GridLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Floating action button: New Game -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/resetFab"
            style="@style/Widget.Ocean.Fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:contentDescription="@string/action_new_game"
            app:layout_anchor="@id/content"
            app:layout_anchorGravity="bottom|end"
            app:srcCompat="@android:drawable/ic_menu_rotate" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Optional navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
