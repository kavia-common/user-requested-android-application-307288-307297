<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ocean_surface"
        app:title="@string/title_tic_tac_toe"
        app:titleTextColor="@color/ocean_text"
        app:elevation="2dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/ocean_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Turn: X"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Board -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/board"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:alignmentMode="alignMargins"
            app:columnCount="3"
            app:rowCount="3"
            app:useDefaultMargins="true"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1">

            <!-- Row 0 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="0"
                app:layout_column="0"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="0"
                app:layout_column="1"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="0"
                app:layout_column="2"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <!-- Row 1 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="1"
                app:layout_column="0"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="1"
                app:layout_column="1"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell5"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="1"
                app:layout_column="2"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <!-- Row 2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell6"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="2"
                app:layout_column="0"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell7"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="2"
                app:layout_column="1"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cell8"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_row="2"
                app:layout_column="2"
                android:background="@drawable/bg_cell"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textColor="@color/ocean_text"
                android:textSize="28sp"
                app:rippleColor="@color/ocean_primary" />

        </androidx.gridlayout.widget.GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/resetFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="@string/action_reset"
        app:layout_anchor="@id/content"
        app:layout_anchorGravity="bottom|end"
        app:srcCompat="@android:drawable/ic_menu_revert"
        app:backgroundTint="@color/ocean_secondary"
        app:tint="@color/ocean_text" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
