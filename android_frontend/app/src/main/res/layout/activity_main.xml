<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ocean_surface"
        app:title="@string/title_tic_tac_toe"
        app:titleTextColor="@color/ocean_text"
        app:elevation="2dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Prominent turn indicator -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/turnCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ocean_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/ocean_outline"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/turnLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_current_turn"
                    android:textColor="@color/ocean_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_turn_pill"
                    android:textColor="@color/ocean_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="X" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/subtitleHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_tap_to_play"
                    android:textColor="@color/ocean_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- End-state message area (shown only on win/draw) -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_result_banner"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ocean_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            tools:text="X wins!"
            app:layout_constraintTop_toBottomOf="@id/turnCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Board host to enforce centered square sizing -->
        <FrameLayout
            android:id="@+id/boardHost"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/resultText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1">

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:alignmentMode="alignMargins"
                app:columnCount="3"
                app:rowCount="3"
                app:useDefaultMargins="true">

                <!-- Row 0 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell0"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="0"
                    app:layout_column="0"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="0"
                    app:layout_column="1"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="0"
                    app:layout_column="2"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <!-- Row 1 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell3"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="1"
                    app:layout_column="0"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell4"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="1"
                    app:layout_column="1"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="1"
                    app:layout_column="2"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <!-- Row 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell6"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="2"
                    app:layout_column="0"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell7"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="2"
                    app:layout_column="1"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cell8"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:contentDescription="@string/cell_content_description"
                    app:layout_row="2"
                    app:layout_column="2"
                    app:layout_rowWeight="1"
                    app:layout_columnWeight="1"
                    android:background="@drawable/bg_cell"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/ocean_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:rippleColor="@color/ocean_primary" />

            </androidx.gridlayout.widget.GridLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/resetFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="@string/action_reset"
        app:layout_anchor="@id/content"
        app:layout_anchorGravity="bottom|end"
        app:srcCompat="@android:drawable/ic_menu_revert"
        app:backgroundTint="@color/ocean_secondary"
        app:tint="@color/ocean_text" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
