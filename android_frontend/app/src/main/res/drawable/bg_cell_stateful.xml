<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ocean_ripple">

    <!-- Base cell surface with stroke; focus ring is applied via state list below -->
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item>
        <selector>
            <!-- Focus state: show a high-contrast ring and slightly stronger stroke -->
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/ocean_surface" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/ocean_focus" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/ocean_surface" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/ocean_primary" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <!-- Default -->
            <item>
                <shape>
                    <solid android:color="@color/ocean_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/ocean_outline" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
